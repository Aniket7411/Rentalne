# Prevent caching of index.html so deploy updates load new CSS/JS
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Cache hashed assets (CSS/JS) for 1 year - safe because filenames change each build
/static/*
  Cache-Control: public, max-age=31536000, immutable
